+class StartServiceTests(unittest.TestCase):
+    @unittest.skipUnless(os.name == "nt", "只有 Windows 的同步管道会这样")
+    def test_started_service_does_not_wait_for_daemon_stdin(self):
+        # daemon 的主循环一直在读 stdin 等下一条命令（插件给的管道）。它拉起的服务如果继承这根管道，
+        # Windows 上子进程连 Python 启动都过不去，要等下一条命令到了才动。
+        helper = textwrap.dedent(
+            """
+            import sys, threading, time
+            from pathlib import Path
+            from vram_switcher.system import SystemAdapter
+            threading.Thread(target=sys.stdin.readline, daemon=True).start()
+            time.sleep(0.3)
+            marker = Path(sys.argv[1])
+            SystemAdapter().start_service("tts", {}, {"args": [
+                sys.executable, "-c", f"open(r'{marker}', 'w').write('started')"]})
+            deadline = time.monotonic() + 8
+            while not marker.exists() and time.monotonic() < deadline:
+                time.sleep(0.1)
+            print("started" if marker.exists() else "blocked", flush=True)
+            """
+        )
+        with tempfile.TemporaryDirectory() as tmp:
+            marker = Path(tmp) / "started.txt"
+            proc = subprocess.Popen(
+                [sys.executable, "-c", helper, str(marker)],
+                cwd=ROOT,
+                stdin=subprocess.PIPE,
+                stdout=subprocess.PIPE,
+                stderr=subprocess.PIPE,
+                text=True,
+            )
+            # stdin 开着不写：helper 的读线程一直挂着，和 daemon 等命令时一样。30 秒兜底关掉，免得测试卡死
+            watchdog = threading.Timer(30, proc.stdin.close)
+            watchdog.start()
+            try:
+                line = proc.stdout.readline().strip()
+            finally:
+                watchdog.cancel()
+                proc.stdin.close()
+                proc.wait(timeout=30)
+            self.assertEqual(line, "started", proc.stderr.read())
+
+
 if __name__ == "__main__":
     unittest.main()
