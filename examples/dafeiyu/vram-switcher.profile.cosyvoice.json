{
  "version": 1,
  "enabled": true,
  "services": {
    "llm": {
      "enabled": false,
      "label": "不用本地 LLM（对话走 DeepSeek 云端）"
    },
    "tts": {
      "enabled": true,
      "label": "CosyVoice3 网关",
      "port": 7861,
      "host": "127.0.0.1",
      "process_names": [
        "python.exe"
      ],
      "cmdline_contains": [
        "cosyvoice_gateway.py"
      ],
      "stop": {
        "timeout_seconds": 20,
        "tree": false
      },
      "busy_flag": "D:/AI/vram-switcher/data/tts_busy.flag",
      "ready_flag": "D:/AI/vram-switcher/data/tts_ready.flag",
      "flag_stale_seconds": 900,
      "start_cooldown_seconds": 10,
      "version_selector": "auto",
      "default_version": "3",
      "detect": {
        "3": [
          "cosyvoice_gateway.py"
        ]
      },
      "versions": {
        "3": {
          "args": [
            "C:/Users/你的用户名/miniconda3/envs/cosyvoice/python.exe",
            "D:/AI/CosyVoice/cosyvoice_gateway.py",
            "--model-dir",
            "pretrained_models/Fun-CosyVoice3-0.5B",
            "--voices",
            "D:/AI/voices",
            "--default-voice",
            "dafeiyu",
            "--port",
            "7861",
            "--fp16"
          ],
          "cwd": "D:/AI/CosyVoice",
          "env": {
            "PYTHONUNBUFFERED": "1"
          },
          "log_file": "D:/AI/vram-switcher/data/tts.log"
        }
      }
    },
    "image": {
      "enabled": true,
      "label": "ComfyUI",
      "port": 8188,
      "host": "127.0.0.1",
      "process_names": [
        "python.exe"
      ],
      "cmdline_contains": [
        "ComfyUI"
      ],
      "stop_by_port": true,
      "stop": {
        "timeout_seconds": 20,
        "tree": false
      },
      "start": {
        "args": [
          "D:/AI/ComfyUI_windows_portable/python_embeded/python.exe",
          "-u",
          "-s",
          "D:/AI/ComfyUI_windows_portable/ComfyUI/main.py",
          "--windows-standalone-build",
          "--disable-auto-launch"
        ],
        "cwd": "D:/AI/ComfyUI_windows_portable/ComfyUI",
        "log_file": "D:/AI/vram-switcher/data/comfyui.log"
      },
      "ready": {
        "type": "port",
        "timeout_seconds": 300
      },
      "queue": {
        "timeout_seconds": 420,
        "interval_seconds": 6
      }
    }
  },
  "aux_services": [],
  "policy": {
    "free_tts_before_image": true,
    "keep_tts_resident": true,
    "tts_poll_seconds": 2
  },
  "lock_file": "D:/AI/vram-switcher/data/coordinator.lock",
  "lock_timeout_seconds": 900
}